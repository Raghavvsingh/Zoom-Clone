# ──────────────────────────────────────────────────────────────
# Zoom Clone Backend — Environment Variables
# Copy this file to .env for local development.
# On Railway, set these as environment variables in the dashboard.
# ──────────────────────────────────────────────────────────────

# SQLite DB path (Railway persistent storage mounts at /data)
# For Railway production, use: sqlite:////data/zoom_clone.db
DATABASE_URL=sqlite:///./zoom_clone.db

# Your deployed Vercel frontend URL (set this after Vercel deploy)
FRONTEND_URL=https://your-app.vercel.app

# Additional comma-separated CORS origins (optional)
EXTRA_CORS_ORIGINS=

# Environment tag
APP_ENV=production
